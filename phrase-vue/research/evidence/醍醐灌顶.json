        "senses": [
            {
                "definition": "佛教比喻以智慧灌输于人，使人彻底醒悟。",
                "citations": [
                    {
                        "text": "闻名之如露入心，共语似醍醐灌顶。",
                        "source": "《敦煌变文集·维摩诘经讲经文》"
                    },
                    {
                        "text": "其宿酲未解，病暍未苏，得此而食，世俗所谓醍醐灌顶，甘露洒心。",
                        "source": "元·王祯《农书》"
                    }
                ]
            },
