        "senses": [
            {
                "definition": "形容像一条衣带那样窄的水流，指江河等水域狭窄。",
                "citations": [
                    {
                        "text": "隋文帝谓仆射高熲曰：「我为百姓父母，岂可限一衣带水不拯之乎？",
                        "source": "唐·李延寿《南史·陈纪下》"
                    },
                    {
                        "text": "望江上之青峰，指湘皋之云树。汉沔相踞，一衣带水，俟君于油口之渡。",
                        "source": "明·袁宏道《戏作三星行送曹子野归楚时予亦将归里》"
                    }
                ]
            },
            {
                "definition": "泛指江河湖海等水域不足以构成阻隔。",
                "citations": []
            }
        ],
