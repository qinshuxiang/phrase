      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
      "text": "那么大家就在纷纷的",
      "start": 227.86,
      "end": 230.0,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
