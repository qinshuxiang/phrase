      "end": 193.85999999999999,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1235,
      "compression_ratio": 1.3827
    },
    {
      "text": "没有根据的来源不靠谱的",
      "start": 193.85999999999999,
      "end": 196.78,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1235,
      "compression_ratio": 1.3827
    },
    {
      "text": "好继续往后走",
      "start": 196.78,
      "end": 198.54,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1235,
      "compression_ratio": 1.3827
    },
    {
      "text": "看街谈相义",
