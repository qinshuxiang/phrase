      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
      "text": "然后呢说",
      "start": 218.60000000000002,
      "end": 220.04000000000002,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
      "text": "这个区呢被当地老百姓",
      "start": 220.04000000000002,
      "end": 222.08,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
      "text": "免费发放了一个新年礼物",
      "start": 222.08,
      "end": 223.92000000000002,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
      "text": "发挂历呗对不对",
      "start": 223.92000000000002,
      "end": 225.36,
      "no_speech_prob": 0.0,
      "avg_logprob": -0.1262,
      "compression_ratio": 1.4045
    },
    {
